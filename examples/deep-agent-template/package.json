{
  "name": "deep-agent-template",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "langgraphjs dev",
    "build": "langgraphjs build",
