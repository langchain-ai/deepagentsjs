    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/langgraph-cli": "1.4.4",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "langsmith": "^0.7.17",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
